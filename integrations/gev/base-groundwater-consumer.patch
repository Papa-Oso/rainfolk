+++ b/src/layers/usGroundwater/pack.test.mjs
@@ -0,0 +1,235 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import crypto from 'node:crypto';
+import { validateWellPack, wellDetails, WELL_LIMITS } from './pack.js';
+import { createWellPackSource } from './source.js';
+const fixture = new URL(
+  '../../../fixtures/us-groundwater/v1/',
+  import.meta.url,
+);
+const load = () =>
+  JSON.parse(fs.readFileSync(new URL('expected-pack.json', fixture)));
+const capture = JSON.parse(fs.readFileSync(new URL('capture.json', fixture)));
+
+test('versioned capture hashes and every well/observation join match original evidence', () => {
+  const hashes = JSON.parse(fs.readFileSync(new URL('sha256.json', fixture)));
+  for (const [name, hash] of Object.entries(hashes))
+    assert.equal(
+      crypto
+        .createHash('sha256')
+        .update(fs.readFileSync(new URL(name, fixture)))
+        .digest('hex'),
+      hash,
+    );
+  const pack = validateWellPack(load());
+  assert.equal(pack.records.length, 6);
+  assert.equal(new Set(pack.records.map((s) => s.metadata.state_code)).size, 6);
+  assert.equal(pack.coverage.complete, false);
+  for (const site of pack.records) {
+    const original = capture.acquisitions[0].response.features.find(
+      (f) => f.id === site.id,
+    );
+    assert.deepEqual(site.metadata, original.properties);
+    assert.deepEqual(
+      [site.longitude, site.latitude],
+      original.geometry.coordinates,
+    );
+    for (const reading of site.readings) {
+      const collection =
+        reading.kind === 'continuous'
+          ? 'latest-continuous'
+          : 'field-measurements';
+      const acquisition = capture.acquisitions.find(
+        (a) => a.collection === collection,
+      );
+      assert.deepEqual(
+        reading.raw,
+        acquisition.response.features.find((f) => f.id === reading.id)
+          .properties,
+      );
+      assert.equal(reading.retrievedAt, acquisition.retrievedAt);
+    }
+  }
+});
+
+test('continuous may be old; discrete dates never become invented UTC instants', () => {
+  const rows = load().records.flatMap((s) => s.readings);
+  assert.equal(rows.filter((r) => r.kind === 'continuous').length, 3);
+  assert.equal(rows.filter((r) => r.kind === 'discrete').length, 3);
+  assert(
+    rows.some(
+      (r) => r.kind === 'continuous' && r.observedAt.startsWith('2014-'),
+    ),
+  );
+  const site = load().records.find((s) =>
+    s.readings.some((r) => r.observedAt === '1939-11-07'),
+  );
+  assert.equal(
+    wellDetails(site).readings[0].observed,
+    '1939-11-07 (day precision)',
+  );
+});
+
+test('missing values, zero, negative and provider text remain distinct', () => {
+  for (const [value, numericValue] of [
+    [null, null],
+    ['', null],
+    ['Ice', null],
+    ['0', 0],
+    ['-2.5', -2.5],
+  ]) {
+    const pack = load();
+    const row = pack.records[0].readings[0];
+    row.value = value;
+    row.raw.value = value;
+    row.numericValue = numericValue;
+    validateWellPack(pack);
+    assert.equal(
+      wellDetails(pack.records[0]).readings[0].value.startsWith('No numeric'),
+      numericValue === null,
+    );
+  }
+  const pack = load();
+  pack.records[0].name = '<img src=x onerror=alert(1)>';
+  assert.equal(
+    wellDetails(validateWellPack(pack).records[0]).name,
+    pack.records[0].name,
+  );
+});
+
+test('metadata-only well means unknown observations, not zero water', () => {
+  const pack = load();
+  pack.records[0].readings = [];
+  validateWellPack(pack);
+  assert.deepEqual(wellDetails(pack.records[0]).readings, []);
+});
+
+test('elevation datum is separate from depth and is never converted', () => {
+  const pack = load();
+  const row = pack.records[0].readings[0];
+  row.parameterCode = '62611';
+  row.raw.parameter_code = '62611';
+  row.reference = 'water-level-elevation';
+  row.datum = 'NAVD88';
+  validateWellPack(pack);
+  assert.match(
+    wellDetails(pack.records[0]).readings[0].reference,
+    /NAVD88; no datum conversion/,
+  );
+  row.reference = 'depth-below-land-surface';
+  assert.throws(() => validateWellPack(pack));
+});
+
+test('refuses stream sites, forged links, locations, joins, duplicate IDs, bad dates and excessive packs', () => {
+  const mutations = [
+    (p) => (p.records[0].metadata.site_type_code = 'ST'),
+    (p) => (p.records[0].metadata.agency_code = 'OTHER'),
+    (p) => (p.records[0].metadata.country_code = 'CA'),
+    (p) => (p.records[0].longitude = null),
+    (p) => (p.records[0].latitude = 91),
+    (p) => (p.records[0].sourceUrl = 'javascript:alert(1)'),
+    (p) => (p.records[0].readings[0].raw.monitoring_location_id = 'USGS-12345'),
+    (p) => p.records.push(p.records[0]),
+    (p) => {
+      const r = p.records[0].readings[0];
+      r.raw.time = r.observedAt = '2026-02-30T00:00:00Z';
+    },
+    (p) => (p.records[0].readings[0].numericValue = 0),
+    (p) => (p.acquisitions[0].url = 'https://example.com/'),
+    (p) => (p.records = Array(WELL_LIMITS.sites + 1).fill(p.records[0])),
+    (p) =>
+      (p.records[0].readings = Array(WELL_LIMITS.readings + 1).fill(
+        p.records[0].readings[0],
+      )),
+  ];
+  for (const mutate of mutations) {
+    const pack = load();
+    mutate(pack);
+    assert.throws(() => validateWellPack(pack));
+  }
+});
+
+test('pack source omits credentials, refuses redirects and external locations', async () => {
+  for (const url of [
+    'https://example.com/pack',
+    '//example.com/pack',
+    '/\\example.com',
+  ])
+    assert.throws(() => createWellPackSource({ url }));
+  let request;
+  const source = createWellPackSource({
+    url: '/fixture.json',
+    fetchImpl: async (url, options) => {
+      request = { url, options };
+      return new Response(JSON.stringify(load()));
+    },
+  });
+  assert.equal((await source.getSnapshot()).records.length, 6);
+  assert.equal(request.options.credentials, 'omit');
+  assert.equal(request.options.redirect, 'error');
+});
+
+test('pack URL admission rejects control-character authority escapes before any fetch', async () => {
+  let calls = 0;
+  const fetchImpl = async () => {
+    calls++;
+    return new Response(JSON.stringify(load()));
+  };
+  for (const control of ['\t', '\n', '\r', '\0', '\u001f', '\u007f']) {
+    assert.throws(
+      () =>
+        createWellPackSource({
+          url: `/${control}/example.org/pack`,
+          fetchImpl,
+        }),
+      /same-origin/,
+    );
+  }
+  const safe = createWellPackSource({
+    url: '/fixtures/../pack.json?encoded=%09',
+    fetchImpl: async (value) => {
+      calls++;
+      const resolved = new URL(value);
+      assert.equal(resolved.origin, 'https://gev.invalid');
+      assert.equal(resolved.pathname, '/pack.json');
+      assert.equal(resolved.search, '?encoded=%09');
+      return new Response(JSON.stringify(load()));
+    },
+  });
+  assert.equal(calls, 0);
+  await safe.getSnapshot();
+  assert.equal(calls, 1);
+});
+
+test('pack source bounds response bytes and preserves cancellation and HTTP failure', async () => {
+  const source = (fetchImpl) =>
+    createWellPackSource({ url: '/fixture.json', fetchImpl });
+  await assert.rejects(
+    source(async () => new Response('{}', { status: 404 })).getSnapshot(),
+    /404/,
+  );
+  await assert.rejects(
+    source(
+      async () =>
+        new Response('{}', {
+          headers: { 'content-length': String(WELL_LIMITS.bytes + 1) },
+        }),
+    ).getSnapshot(),
+    /too large/,
+  );
+  const controller = new AbortController();
+  controller.abort();
+  let calls = 0;
+  await assert.rejects(
+    source(async () => {
+      calls++;
+    }).getSnapshot({ signal: controller.signal }),
+    { name: 'AbortError' },
+  );
+  assert.equal(calls, 0);
+  await assert.rejects(
+    source(async () => new Response('{broken')).getSnapshot(),
+    SyntaxError,
+  );
+});
diff --git a/src/layers/usGroundwater/partitionedCounts.js b/src/layers/usGroundwater/partitionedCounts.js
new file mode 100644
--- /dev/null
+++ b/src/layers/usGroundwater/partitionedCounts.js
@@ -0,0 +1,222 @@
+import {
+  intersects,
+  countView,
+  validateCountOverview,
+  validateCountChunk,
+} from './countGrids.js';
+import { readTiles } from './tileReads.js';
+
+export const COUNT_FETCH_LIMITS = Object.freeze({
+  bytes: 8 * 1024 * 1024,
+  cells: 65536,
+  requests: 64,
+  entries: 96,
+});
+const reference = (ref) => {
+  if (
+    !ref ||
+    !/^[a-f0-9]{64}\.counts\.json$/.test(ref.url) ||
+    ref.url !== `${ref.sha256}.counts.json` ||
+    !Number.isSafeInteger(ref.bytes) ||
+    ref.bytes < 1 ||
+    ref.bytes > COUNT_FETCH_LIMITS.bytes
+  )
+    throw new TypeError('Invalid partitioned count reference');
+};
+
+function validateSubtree(level, previous, bounds) {
+  const parents = previous.cells.filter(
+    (c) =>
+      c.bounds[0] >= bounds[0] &&
+      c.bounds[1] >= bounds[1] &&
+      c.bounds[2] <= bounds[2] &&
+      c.bounds[3] <= bounds[3],
+  );
+  const sums = new Map();
+  for (const cell of level.cells) {
+    const x = Math.floor((cell.bounds[0] + 180) / previous.degrees),
+      y = Math.floor((cell.bounds[1] + 90) / previous.degrees),
+      key = `${x}:${y}`;
+    const sum = sums.get(key) ?? { count: 0, x: 0, y: 0 };
+    sum.count += cell.count;
+    sum.x += cell.center[0] * cell.count;
+    sum.y += cell.center[1] * cell.count;
+    sums.set(key, sum);
+  }
+  if (sums.size !== parents.length)
+    throw new TypeError('Count chunk hierarchy mismatch');
+  for (const parent of parents) {
+    const sum = sums.get(
+      `${Math.round((parent.bounds[0] + 180) / previous.degrees)}:${Math.round((parent.bounds[1] + 90) / previous.degrees)}`,
+    );
+    if (
+      !sum ||
+      sum.count !== parent.count ||
+      Math.abs(sum.x - parent.center[0] * parent.count) > 1e-7 * parent.count ||
+      Math.abs(sum.y - parent.center[1] * parent.count) > 1e-7 * parent.count
+    )
+      throw new TypeError('Count chunk hierarchy mismatch');
+  }
+}
+
+/** Hash-keyed, byte/cell/entry-bounded immutable cache; no request or renderer ownership. */
+export function createPartitionedCountLoader() {
+  const cache = new Map();
+  let bytes = 0,
+    cells = 0;
+  async function obtain(ref, read, validate) {
+    const cached = cache.get(ref.sha256);
+    if (cached) {
+      if (cached.bytes !== ref.bytes)
+        throw new TypeError('Count reference byte mismatch');
+      validate(cached.value);
+      cache.delete(ref.sha256);
+      cache.set(ref.sha256, cached);
+      return cached.value;
+    }
+    const value = await read(ref);
+    validate(value);
+    const count = value.levels.reduce((n, level) => n + level.cells.length, 0);
+    if (count <= COUNT_FETCH_LIMITS.cells) {
+      if (cache.has(ref.sha256)) {
+        const previous = cache.get(ref.sha256);
+        bytes -= previous.bytes;
+        cells -= previous.cells;
+        cache.delete(ref.sha256);
+      }
+      while (
+        cache.size &&
+        (bytes + ref.bytes > COUNT_FETCH_LIMITS.bytes ||
+          cells + count > COUNT_FETCH_LIMITS.cells ||
+          cache.size >= COUNT_FETCH_LIMITS.entries)
+      ) {
+        const key = cache.keys().next().value,
+          old = cache.get(key);
+        bytes -= old.bytes;
+        cells -= old.cells;
+        cache.delete(key);
+      }
+      cache.set(ref.sha256, { value, bytes: ref.bytes, cells: count });
+      bytes += ref.bytes;
+      cells += count;
+    }
+    return value;
+  }
+  return {
+    getCacheStats: () => ({ bytes, cells, entries: cache.size }),
+    async load(ref, total, bounds, budget, read) {
+      if (
+        ref?.schemaVersion !== 2 ||
+        ref.kind !== 'gev-well-partitioned-counts' ||
+        ref.total !== total ||
+        !Array.isArray(ref.levels) ||
+        ref.levels.length !== 2
+      )
+        throw new TypeError('Invalid partitioned count manifest');
+      reference(ref.overview);
+      const overview = await obtain(ref.overview, read, (v) =>
+        validateCountOverview(v, total),
+      );
+      const parents = new Map(
+        overview.levels[2].cells.map((c) => [JSON.stringify(c.bounds), c]),
+      );
+      const urls = new Set([ref.overview.url]);
+      for (const [i, level] of ref.levels.entries()) {
+        if (
+          level.degrees !== [0.125, 0.03125][i] ||
+          !Array.isArray(level.chunks) ||
+          level.chunks.length !== parents.size ||
+          !Number.isSafeInteger(level.cellCount)
+        )
+          throw new TypeError('Invalid partitioned count level');
+        const seen = new Set();
+        let population = 0,
+          occupied = 0;
+        for (const chunk of level.chunks) {
+          reference(chunk);
+          const key = JSON.stringify(chunk.bounds),
+            parent = parents.get(key);
+          if (
+            !parent ||
+            seen.has(key) ||
+            urls.has(chunk.url) ||
+            chunk.count !== parent.count ||
+            !Number.isSafeInteger(chunk.cellCount) ||
+            chunk.cellCount < 1 ||
+            chunk.cellCount > (2 / level.degrees) ** 2
+          )
+            throw new TypeError('Count chunk accounting mismatch');
+          seen.add(key);
+          urls.add(chunk.url);
+          population += chunk.count;
+          occupied += chunk.cellCount;
+        }
+        if (population !== total || occupied !== level.cellCount)
+          throw new TypeError('Partitioned count conservation');
+      }
+      const levels = [...overview.levels];
+      let requestedBytes = 0,
+        requestedCells = 0,
+        requested = 0,
+        capped = false;
+      for (const level of ref.levels) {
+        const matching = level.chunks.filter(
+          (c) => bounds && intersects(c.bounds, bounds),
+        );
+        const levelBytes = matching.reduce((n, c) => n + c.bytes, 0),
+          levelCells = matching.reduce((n, c) => n + c.cellCount, 0);
+        if (
+          requested + matching.length > COUNT_FETCH_LIMITS.requests ||
+          requestedBytes + levelBytes > COUNT_FETCH_LIMITS.bytes ||
+          requestedCells + levelCells > COUNT_FETCH_LIMITS.cells
+        ) {
+          capped = true;
+          break;
+        }
+        requested += matching.length;
+        requestedBytes += levelBytes;
+        requestedCells += levelCells;
+        const chunks = await readTiles(matching, (chunk) =>
+          obtain(chunk, read, (v) => {
+            const parsed = validateCountChunk(
+              v,
+              parents.get(JSON.stringify(chunk.bounds)),
+              level.degrees,
+            );
+            validateSubtree(parsed, levels.at(-1), chunk.bounds);
+            if (parsed.cells.length !== chunk.cellCount)
+              throw new TypeError('Count chunk cell count mismatch');
+          }),
+        );
+        const combined = {
+          degrees: level.degrees,
+          total,
+          cells: chunks.flatMap((v) => v.levels[0].cells),
+        };
+        levels.push(combined);
+        // Match the existing first-over-budget stopping rule; do not fetch a
+        // finer level the renderer cannot yet admit.
+        if (
+          countView({ ...overview, levels }, bounds, '', budget).degrees !==
+          level.degrees
+        )
+          break;
+      }
+      // Views own their cells; a caller cannot mutate cached source evidence.
+      return {
+        grids: {
+          ...overview,
+          levels: levels.map((level) => ({
+            ...level,
+            cells: level.cells.map((c) => ({
+              ...c,
+              bounds: [...c.bounds],
+              center: c.center && [...c.center],
+            })),
+          })),
+        },
+        capped,
+      };
+    },
+  };
+}
diff --git a/src/layers/usGroundwater/partitionedCounts.test.mjs b/src/layers/usGroundwater/partitionedCounts.test.mjs
