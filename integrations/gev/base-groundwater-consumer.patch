+  assert.equal(changed.numberOfListeners, 0);
+  assert.equal(moveEnd.numberOfListeners, 0);
+  assert.equal(data.clustering.enabled, false);
+  assert.ok(clears >= 1);
+});
+
+test('4096 aggregate inputs stay in one bounded native clustering source', () => {
+  const start = performance.now();
+  const owned = new Cesium.CustomDataSource('bounded-inputs');
+  const viewer = {
+    scene: {
+      canvas: { clientWidth: 2560, clientHeight: 1276 },
+      requestRender() {},
+    },
+    camera: {},
+  };
+  const cells = Array.from({ length: 4096 }, (_, i) => {
+    const x = i % 64,
+      y = Math.floor(i / 64);
+    return {
+      bounds: [x / 32, y / 32, (x + 1) / 32, (y + 1) / 32],
+      count: 1,
+      center: [(x + 0.5) / 32, (y + 0.5) / 32],
+    };
+  });
+  const renderer = createCountRenderer(viewer, {
