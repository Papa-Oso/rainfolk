+test('tile reads are bounded to four, ordered, and stop queuing after failure', async () => {
+  let active = 0,
+    peak = 0;
+  const result = await readTiles([0, 1, 2, 3, 4, 5, 6, 7], async (n) => {
+    peak = Math.max(peak, ++active);
+    await new Promise(setImmediate);
+    active--;
+    return n * 2;
+  });
