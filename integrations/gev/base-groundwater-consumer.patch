+    checks.push(
+      'painted sparse native flag click selects the exact source-backed well',
+    );
+  } catch {
+    visualGaps.push(
+      'Sparse flag hit/selection was not stable after camera settlement; native flag interaction is not accepted.',
+    );
+  }
+  await page.screenshot({ path: path.join(out, 'sparse-flag.png') });
+  if (!flagSelected) {
+    const point = await page.evaluate(() =>
+      qa.point(qa.records[0].longitude, qa.records[0].latitude),
+    );
+    await page.mouse.click(point.x, point.y);
+  }
+  await page.waitForFunction(() => qa.selected?.id === qa.records[0].id);
+  const selection = await page.evaluate(() => ({
+    actual: qa.selected,
