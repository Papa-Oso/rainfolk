diff --git a/src/layers/usGroundwater/sparseFlags.test.mjs b/src/layers/usGroundwater/sparseFlags.test.mjs
new file mode 100644
--- /dev/null
+++ b/src/layers/usGroundwater/sparseFlags.test.mjs
@@ -0,0 +1,196 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as Cesium from 'cesium';
+import sample from '../../../fixtures/us-groundwater/v1/expected-pack.json' with { type: 'json' };
+import { createCountRenderer } from './countRenderer.js';
+
+function harness(recordCount) {
+  const frame = new Cesium.Event(),
+    changed = new Cesium.Event();
+  let flags = [],
+    selected,
+    requests = 0,
+    inside = true;
+  const data = new Cesium.CustomDataSource('sparse');
+  const records = sample.records.slice(0, recordCount);
+  const entities = records.map((r) =>
+    data.entities.add({
+      id: 'us-groundwater:' + r.id,
+      name: r.name,
+      position: Cesium.Cartesian3.fromDegrees(r.longitude, r.latitude),
+      billboard: { image: 'fixture' },
+    }),
+  );
+  const renderer = createCountRenderer(
+    {
+      scene: {
+        canvas: { clientWidth: 1000, clientHeight: 800 },
+        postRender: frame,
+        requestRender() {
+          requests++;
+        },
+        cartesianToCanvasCoordinates() {
+          return { x: inside ? 500 : 1100, y: 400 };
+        },
+      },
+      camera: { changed, moveEnd: new Cesium.Event() },
+    },
+    {
+      overlays: {
+        setOverlayEntries(_source, entries) {
+          flags = entries;
+        },
+        clearOverlaySource() {
+          flags = [];
+        },
+      },
+      onSelectRecord(entity) {
+        selected = entity;
+        return true;
+      },
+    },
+  );
+  const view = {
+    schemaVersion: 1,
+    kind: 'gev-well-count-view',
+    coverageComplete: false,
+    cells: [],
+    degrees: 0.03125,
+    total: recordCount,
+    detailPack: { ...sample, records },
+  };
+  renderer.draw(view, data, true);
+  return {
+    data,
+    renderer,
+    frame,
+    changed,
+    entities,
+    view,
+    ready() {
+      data.clustering._enabledDirty = false;
+      data.clustering._clusterDirty = false;
+      data.clustering._billboardCollection = { ready: true };
+    },
+    outside() {
+      inside = false;
+      changed.raiseEvent();
+    },
+    get flags() {
+      return flags;
+    },
+    get selected() {
+      return selected;
+    },
+    get requests() {
+      return requests;
+    },
+  };
+}
+
+test('a settled single well gets an actionable flag without any cluster collection', () => {
+  const h = harness(1);
+  h.frame.raiseEvent();
+  assert.equal(h.flags.length, 0, 'no flag before visualizer initialization');
+  h.ready();
+  h.data.clustering._billboardCollection.ready = false;
+  h.frame.raiseEvent();
+  assert.equal(h.flags.length, 0, 'no guess before atlas readiness');
+  h.ready();
+  h.data.clustering._clusterDirty = true;
+  h.frame.raiseEvent();
+  assert.equal(h.flags.length, 0, 'no guess during a pending solve');
+  h.ready();
+  h.frame.raiseEvent();
+  assert.equal(h.flags.length, 1);
+  assert.equal(h.flags[0].id, h.entities[0].id);
+  assert.equal(h.flags[0].activate(), true);
+  assert.equal(h.selected, h.entities[0]);
+  assert.deepEqual(h.renderer.getStats(), {
+    groups: 1,
+    aggregateInputs: 1,
+    recordCount: 1,
+  });
+  const requests = h.requests;
+  for (let i = 0; i < 5; i++) h.frame.raiseEvent();
+  assert.equal(
+    h.requests,
+    requests,
+    'settled zero clusters must not request frames forever',
+  );
+  h.outside();
+  h.frame.raiseEvent();
+  assert.equal(h.flags.length, 0, 'offscreen well has no ambient flag');
+  assert.equal(h.renderer.getStats().groups, 0);
+  assert.equal(h.renderer.getStats().recordCount, 1);
+  h.renderer.clear();
+});
+
+test('clustered-to-sparse and sparse-to-clustered transitions conserve counts without duplicate flags', () => {
+  const h = harness(2);
+  h.ready();
+  const cluster = { point: {}, label: {}, billboard: {} };
+  const group = () => {
+    h.data.clustering.clusterEvent.raiseEvent(h.entities, cluster);
+    h.data.clustering._clusterBillboardCollection = {
+      length: 1,
+      get: () => cluster.billboard,
+    };
+    h.changed.raiseEvent();
+    h.frame.raiseEvent();
+  };
+  group();
+  assert.equal(h.flags.length, 0);
+  assert.equal(h.renderer.getStats().recordCount, 2);
+  h.data.clustering._clusterBillboardCollection = undefined;
+  h.data.clustering._clusterPointCollection = undefined;
+  h.changed.raiseEvent();
+  h.frame.raiseEvent();
+  assert.deepEqual(
+    h.flags.map((f) => f.id).sort(),
+    h.entities.map((e) => e.id).sort(),
+  );
+  assert.equal(h.renderer.getStats().groups, 2);
+  assert.equal(h.renderer.getStats().recordCount, 2);
+  group();
+  assert.equal(h.flags.length, 0);
+  assert.equal(h.renderer.getStats().groups, 1);
+  h.renderer.clear();
+});
+
+test('an empty owned viewport and an unloaded aggregate singleton never fabricate exact-well flags', () => {
+  const h = harness(1);
+  h.ready();
+  h.frame.raiseEvent();
+  assert.equal(h.flags.length, 1);
+  h.data.entities.removeAll();
+  h.renderer.draw(
+    { ...h.view, detailPack: { ...sample, records: [] } },
+    h.data,
+    true,
+  );
+  h.frame.raiseEvent();
+  assert.equal(h.flags.length, 0);
+  assert.equal(h.renderer.getStats().recordCount, 0);
+  h.renderer.draw(
+    {
+      schemaVersion: 1,
+      kind: 'gev-well-count-view',
+      coverageComplete: false,
+      total: 1,
+      degrees: 2,
+      cells: [{ bounds: [0, 0, 2, 2], count: 1, center: [1, 1] }],
+    },
+    h.data,
+  );
+  h.ready();
+  h.frame.raiseEvent();
+  assert.equal(
+    h.flags.length,
+    0,
+    'aggregate count one is not an exact loaded well',
+  );
+  assert.equal(h.renderer.getStats().recordCount, 1);
+  assert.equal(h.renderer.getStats().groups, 1);
+  h.renderer.clear();
+});
