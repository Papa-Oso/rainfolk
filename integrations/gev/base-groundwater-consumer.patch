+import groundwaterPack from '../../../fixtures/us-groundwater/v1/expected-pack.json' with { type: 'json' };
+import { msg } from '../../i18n/marker.js';
+import { createSpatialWellSource } from './spatialSource.js';
+
+/** Default sample or generic local static index; no producer runtime required. */
+export function createBundledWellPackSource({ pilot = 'sample' } = {}) {
+  if (pilot === 'indexed') return createSpatialWellSource();
+  if (pilot !== 'sample')
+    throw new TypeError('Unknown bundled groundwater source');
+  return {
+    label: msg('USGS (bounded six-site snapshot)'),
+    async getSnapshot({ signal } = {}) {
+      signal?.throwIfAborted();
+      return structuredClone(groundwaterPack);
+    },
+  };
+}
diff --git a/src/layers/usGroundwater/countGrids.js b/src/layers/usGroundwater/countGrids.js
new file mode 100644
--- /dev/null
+++ b/src/layers/usGroundwater/countGrids.js
@@ -0,0 +1,230 @@
+import { validateWellPack } from './pack.js';
+/** Distinct count-grid contract. Counts describe source locations, never water. */
+export const GRID_SIZES = [32, 8, 2, 0.5, 0.125, 0.03125];
+// Aggregate input budget, independent from the 2,000-record detail contract.
+export const COUNT_LIMIT = 4096;
+export const intersects = (a, b) =>
+  a[1] < b[3] &&
+  a[3] > b[1] &&
+  (b[0] <= b[2] ? a[0] < b[2] && a[2] > b[0] : a[2] > b[0] || a[0] < b[2]);
+const validCenter = (c, required) => {
+  if (!c.center) return !required;
+  return (
+    Array.isArray(c.center) &&
+    c.center.length === 2 &&
+    c.center.every(Number.isFinite) &&
+    c.center[0] >= c.bounds[0] - 1e-9 &&
+    c.center[0] <= c.bounds[2] + 1e-9 &&
+    c.center[1] >= c.bounds[1] - 1e-9 &&
+    c.center[1] <= c.bounds[3] + 1e-9
+  );
+};
+export function validateCountGrids(value, total) {
+  return validateLevels(value, total, GRID_SIZES);
+}
+export function validateCountOverview(value, total) {
+  if (value?.centerMethod !== 'record-mean')
+    throw new TypeError('Weighted count overview required');
+  return validateLevels(value, total, GRID_SIZES.slice(0, 4));
+}
+export function validateCountChunk(value, parent, degrees) {
+  if (value?.centerMethod !== 'record-mean')
+    throw new TypeError('Weighted count chunk required');
+  if (
+    !GRID_SIZES.slice(4).includes(degrees) ||
+    JSON.stringify(value?.parentBounds) !== JSON.stringify(parent.bounds)
+  )
+    throw new TypeError('Invalid count chunk parent');
+  validateLevels(value, parent.count, [degrees]);
+  const cells = value.levels[0].cells;
+  const weighted = [0, 0];
+  for (const c of cells) {
+    if (
+      c.bounds[0] < parent.bounds[0] ||
+      c.bounds[1] < parent.bounds[1] ||
+      c.bounds[2] > parent.bounds[2] ||
+      c.bounds[3] > parent.bounds[3]
+    )
+      throw new TypeError('Count chunk outside parent');
+    for (let axis = 0; axis < 2; axis++)
+      weighted[axis] += c.center[axis] * c.count;
+  }
+  for (let axis = 0; axis < 2; axis++)
+    if (
+      Math.abs(weighted[axis] - parent.center[axis] * parent.count) >
+      1e-7 * parent.count
+    )
+      throw new TypeError('Count chunk weighted conservation');
+  return value.levels[0];
+}
+function validateLevels(value, total, sizes) {
+  if (
+    value?.schemaVersion !== 1 ||
+    value.kind !== 'gev-well-count-grids' ||
+    value.total !== total ||
+    !Number.isSafeInteger(total) ||
+    total < 1 ||
+    value.levels?.length !== sizes.length
+  )
+    throw new TypeError('Invalid count grids');
+  let parents;
+  for (let i = 0; i < sizes.length; i++) {
+    const size = sizes[i],
+      level = value.levels[i];
+    if (
+      level.degrees !== size ||
+      level.total !== total ||
+      !Array.isArray(level.cells) ||
+      level.cells.length > 250000
+    )
+      throw new TypeError('Invalid grid level');
+    const cells = new Map(),
+      sums = new Map();
+    let sum = 0;
+    for (const c of level.cells) {
+      const b = c.bounds;
+      if (
+        !Array.isArray(b) ||
+        b.length !== 4 ||
+        !b.every(Number.isFinite) ||
+        b[0] < -180 ||
+        b[2] > 180 ||
+        b[1] < -90 ||
+        b[3] > 90 ||
+        !Number.isSafeInteger(c.count) ||
+        c.count < 1
+      )
+        throw new TypeError('Invalid count cell');
+      const x = (b[0] + 180) / size,
+        y = (b[1] + 90) / size;
+      if (
+        !Number.isInteger(x) ||
+        !Number.isInteger(y) ||
+        b[2] !== Math.min(180, b[0] + size) ||
+        b[3] !== Math.min(90, b[1] + size) ||
+        b[0] >= b[2] ||
+        b[1] >= b[3]
+      )
+        throw new TypeError('Unaligned grid');
+      const key = `${x}:${y}`;
+      if (cells.has(key)) throw new TypeError('Overlapping grid');
+      if (!validCenter(c, value.centerMethod === 'record-mean'))
+        throw new TypeError('Invalid weighted center');
+      cells.set(key, {
+        count: c.count,
+        x: (c.center?.[0] ?? 0) * c.count,
+        y: (c.center?.[1] ?? 0) * c.count,
+      });
+      sum += c.count;
+      if (i) {
+        const ratio = sizes[i - 1] / size;
+        const p = `${Math.floor(x / ratio)}:${Math.floor(y / ratio)}`;
+        const v = sums.get(p) || { count: 0, x: 0, y: 0 };
+        v.count += c.count;
+        v.x += (c.center?.[0] ?? 0) * c.count;
+        v.y += (c.center?.[1] ?? 0) * c.count;
+        sums.set(p, v);
+      }
+    }
+    if (
+      sum !== total ||
+      (parents &&
+        (sums.size !== parents.size ||
+          [...parents].some(([k, v]) => {
+            const s = sums.get(k);
+            return (
+              !s ||
+              s.count !== v.count ||
+              (value.centerMethod === 'record-mean' &&
+                (Math.abs(s.x - v.x) > 1e-7 * v.count ||
+                  Math.abs(s.y - v.y) > 1e-7 * v.count))
+            );
+          })))
+    )
+      throw new TypeError('Grid conservation or hierarchy failure');
+    parents = cells;
+  }
+  return value;
+}
+export function countView(grids, bounds, reason, budget = COUNT_LIMIT) {
+  if (!Number.isInteger(budget) || budget < 1 || budget > COUNT_LIMIT)
+    throw new TypeError('Invalid cell budget');
+  let cells = [];
+  let degrees = GRID_SIZES[0];
+  for (const level of grids.levels) {
+    const next = bounds
+      ? level.cells.filter((c) => intersects(c.bounds, bounds))
+      : [];
+    if (next.length > budget) break;
+    cells = next;
+    degrees = level.degrees;
+  }
+  return validateCountView({
+    schemaVersion: 1,
+    kind: 'gev-well-count-view',
+    cells,
+    centerMethod: grids.centerMethod,
+    degrees,
+    total: grids.total,
+    reason,
+    coverageComplete: false,
+  });
+}
+export function validateCountView(view) {
+  if (
+    view?.kind !== 'gev-well-count-view' ||
+    view.schemaVersion !== 1 ||
+    view.coverageComplete !== false ||
+    !Array.isArray(view.cells) ||
+    view.cells.length > COUNT_LIMIT ||
+    !GRID_SIZES.includes(view.degrees) ||
+    !Number.isSafeInteger(view.total)
+  )
+    throw new TypeError('Invalid count view');
+  const seen = new Set();
+  let sum = 0;
+  for (const c of view.cells) {
+    const b = c.bounds,
+      size = view.degrees;
+    if (
+      !Array.isArray(b) ||
+      b.length !== 4 ||
+      !b.every(Number.isFinite) ||
+      b[0] < -180 ||
+      b[2] > 180 ||
+      b[1] < -90 ||
+      b[3] > 90 ||
+      !Number.isInteger((b[0] + 180) / size) ||
+      !Number.isInteger((b[1] + 90) / size) ||
+      b[2] !== Math.min(180, b[0] + size) ||
+      b[3] !== Math.min(90, b[1] + size) ||
+      b[0] >= b[2] ||
+      b[1] >= b[3] ||
+      !Number.isSafeInteger(c.count) ||
+      c.count < 1 ||
+      seen.has(JSON.stringify(b))
+    )
+      throw new TypeError('Invalid count view cell');
+    if (!validCenter(c, view.centerMethod === 'record-mean'))
+      throw new TypeError('Invalid weighted center');
+    seen.add(JSON.stringify(b));
+    sum += c.count;
+  }
+  if (view.detailPack) {
+    validateWellPack(view.detailPack);
+    for (const r of view.detailPack.records) {
+      if (view.cells.some((c) => containsLocation(c.bounds, r)))
+        throw new TypeError('Detail overlaps an unreplaced aggregate');
+    }
+    sum += view.detailPack.records.length;
+  }
+  if (sum > view.total) throw new TypeError('Invalid count view total');
+  return view;
+}
+
+// Half-open cells assign a boundary location to exactly one aggregate.
+export const containsLocation = (b, r) =>
+  r.longitude >= b[0] &&
+  (r.longitude < b[2] || (b[2] === 180 && r.longitude === 180)) &&
+  r.latitude >= b[1] &&
+  (r.latitude < b[3] || (b[3] === 90 && r.latitude === 90));
diff --git a/src/layers/usGroundwater/countRenderer.js b/src/layers/usGroundwater/countRenderer.js
new file mode 100644
--- /dev/null
+++ b/src/layers/usGroundwater/countRenderer.js
@@ -0,0 +1,385 @@
+import * as Cesium from 'cesium';
+import { t } from '../../i18n/index.js';
+import { createInfrastructureOverlayEntry } from '../../data/infrastructureOverlayEntry.js';
+import { validateCountView } from './countGrids.js';
+
+export const circleDiameter = (count) =>
+  count < 10 ? 22 : count < 100 ? 28 : count < 1000 ? 36 : 44;
+export const circleLabel = (count) =>
+  count < 1000
+    ? String(count)
+    : new Intl.NumberFormat('en', {
+        notation: 'compact',
+        maximumFractionDigits: 1,
+      }).format(count);
+const SOURCE = 'us-groundwater-counts';
+export function wellMarkerImage(hasReadings) {
+  const fill = hasReadings ? '#56b4e9' : '#c6d0d4';
+  return (
+    'data:image/svg+xml;charset=utf-8,' +
+    encodeURIComponent(
+      `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 12 12"><circle cx="6" cy="6" r="4.5" fill="${fill}" stroke="#071b25" stroke-width="2"/></svg>`,
+    )
+  );
+}
+// One scene billboard carries both circle and text. A separate point primitive
+// can paint over a label at the same depth, hiding the count entirely.
+export function countMarkerImage(count) {
+  const size = circleDiameter(count),
+    r = size / 2;
+  // Rasterize the SVG into Cesium's atlas at 3x; billboard dimensions remain
+  // CSS-sized. This improves marker typography without changing scene quality.
+  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size * 3}" height="${size * 3}" viewBox="0 0 ${size} ${size}"><circle cx="${r}" cy="${r}" r="${r - 2}" fill="#17658f" stroke="#071b25" stroke-width="2"/><text x="${r}" y="${r}" dy=".35em" text-anchor="middle" font-family="Arial,sans-serif" font-weight="bold" font-size="12" fill="white">${circleLabel(count)}</text></svg>`;
+  return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
+}
+/** Sum record weights, never the number of Cesium aggregate entities. */
+export function aggregateMembers(entities, cells) {
+  const ids = [...new Set(entities.map((e) => e.id))].sort();
+  let count = 0,
+    x = 0,
+    y = 0,
+    origin;
+  const ranges = [];
+  let south = 90,
+    north = -90;
+  for (const id of ids) {
+    const c = cells.get(id);
+    if (!c) throw new TypeError('Unknown aggregate member');
+    const center = c.center ?? [
+      (c.bounds[0] + c.bounds[2]) / 2,
+      (c.bounds[1] + c.bounds[3]) / 2,
+    ];
+    if (origin === undefined) origin = center[0];
+    let lon = center[0];
+    while (lon - origin > 180) lon -= 360;
+    while (lon - origin < -180) lon += 360;
+    count += c.count;
+    x += lon * c.count;
+    y += center[1] * c.count;
+    const [w, s, e, n] = c.bounds;
+    south = Math.min(south, s);
+    north = Math.max(north, n);
+    if (w <= e) ranges.push([w + 180, e + 180]);
+    else ranges.push([w + 180, 360], [0, e + 180]);
+  }
+  if (!count) throw new TypeError('Empty aggregate group');
+  ranges.sort((a, b) => a[0] - b[0]);
+  const merged = [];
+  for (const r of ranges) {
+    const last = merged.at(-1);
+    if (last && r[0] <= last[1]) last[1] = Math.max(last[1], r[1]);
+    else merged.push([...r]);
+  }
+  let gap = -1,
+    start = 0,
+    end = 360;
+  for (let i = 0; i < merged.length; i++) {
+    const current = merged[i],
+      next = merged[(i + 1) % merged.length];
+    const nextStart = next[0] + (i === merged.length - 1 ? 360 : 0);
+    if (nextStart - current[1] > gap) {
+      gap = nextStart - current[1];
+      start = nextStart;
+      end = current[1];
+    }
+  }
+  const bounds =
+    gap <= 0
+      ? [-180, south, 180, north]
+      : [(start % 360) - 180, south, (end % 360) - 180, north];
+  return {
+    ids,
+    count,
+    center: [((x / count + 540) % 360) - 180, y / count],
+    bounds,
+  };
+}
+/** Native scene markers stay beneath the scope mask. Only sparse info flags
+ * use the shared, keyhole-faded infrastructure card host. */
+export function createCountRenderer(
+  viewer,
+  {
+    overlays,
+    onSelectGroup = () => {},
+    onSelectRecord = () => {},
+    onError = () => {},
+  } = {},
+) {
+  let signature,
+    dataSource,
+    removeCluster,
+    removeFrame,
+    removeChanged,
+    removeEnd,
+    dirty = true;
+  let lastSignature = '';
+  let screenGroups = 0;
+  let inputCount = 0;
+  const cells = new Map();
+  function clear(retainOverlay = false) {
+    signature = undefined;
+    lastSignature = '';
+    cells.clear();
+    screenGroups = 0;
+    inputCount = 0;
+    removeCluster?.();
+    removeFrame?.();
+    removeChanged?.();
+    removeEnd?.();
+    removeCluster = removeFrame = removeChanged = removeEnd = undefined;
+    if (dataSource) dataSource.clustering.enabled = false;
+    dataSource = undefined;
+    if (!retainOverlay) {
+      overlays?.clearOverlaySource(SOURCE);
+      overlays?.setOverlaySourceVisible?.(SOURCE, false);
+    }
+  }
+  function zoomGroup(g) {
+    onSelectGroup(g.count);
+    const b = [...g.bounds];
+    if (b[0] === b[2]) {
+      b[0] = Math.max(-180, b[0] - 0.001);
+      b[2] = Math.min(180, b[2] + 0.001);
+    }
+    if (b[1] === b[3]) {
+      b[1] = Math.max(-90, b[1] - 0.001);
+      b[3] = Math.min(90, b[3] + 0.001);
+    }
+    viewer.camera.flyTo({
+      destination: Cesium.Rectangle.fromDegrees(...b),
+      duration: 0.7,
+    });
+    return true;
+  }
+  function zoom(entity) {
+    if (Array.isArray(entity) && entity.some((e) => !cells.has(e.id)))
+      return false;
+    if (!Array.isArray(entity) && cells.get(entity?.id)?.record) return false;
+    const members = Array.isArray(entity)
+      ? entity
+      : cells.has(entity?.id)
+        ? [entity]
+        : null;
+    return members?.length
+      ? zoomGroup(aggregateMembers(members, cells))
+      : false;
+  }
+  function publish() {
+    if (!dirty || !dataSource) return;
+    // This private collection is the same pinned Cesium 1.138 seam used by radio.
+    const clustering = dataSource.clustering;
+    const points =
+      clustering._clusterBillboardCollection ??
+      clustering._clusterPointCollection;
+    // Cesium removes empty cluster collections after a completed solve. That
+    // means zero groups, not an unready visualizer: publish the exact singletons.
+    // Before the billboard atlas/solve is ready, do not guess which are singletons.
+    if (
+      !points &&
+      inputCount > 0 &&
+      (clustering._enabledDirty ||
+        clustering._clusterDirty ||
+        !clustering._billboardCollection?.ready)
+    ) {
+      viewer.scene.requestRender?.();
+      return;
+    }
+    const groups = [],
+      assigned = new Set();
+    for (let i = 0; i < (points?.length ?? 0); i++) {
+      const point = points.get(i);
+      if (!point.show || !Array.isArray(point.id)) continue;
+      if (point.id.some((e) => !cells.has(e.id))) {
+        viewer.scene.requestRender?.();
+        return;
+      }
+      const g = aggregateMembers(point.id, cells);
+      for (const id of g.ids) {
+        if (assigned.has(id))
+          throw new TypeError('Overlapping screen clusters');
+        assigned.add(id);
+      }
+      groups.push(g);
+    }
+    for (const entity of dataSource.entities.values)
+      if (!assigned.has(entity.id))
+        groups.push(aggregateMembers([entity], cells));
+    if (groups.reduce((n, g) => n + g.count, 0) !== inputCount)
+      throw new TypeError('Screen group conservation failed');
+    const canvas = viewer.scene.canvas ?? {};
+    const visibleGroups = groups.filter((g) => {
+      const pos = Cesium.Cartesian3.fromDegrees(...g.center);
+      if (
+        viewer.camera.positionWC &&
+        !new Cesium.EllipsoidalOccluder(
+          Cesium.Ellipsoid.WGS84,
+          viewer.camera.positionWC,
+        ).isPointVisible(pos)
+      )
+        return false;
+      if (typeof viewer.scene.cartesianToCanvasCoordinates !== 'function')
+        return true;
+      const p = viewer.scene.cartesianToCanvasCoordinates(pos);
+      return (
+        p &&
+        p.x >= 0 &&
+        p.y >= 0 &&
+        p.x <= canvas.clientWidth &&
+        p.y <= canvas.clientHeight
+      );
+    });
+    dirty = false;
+    screenGroups = visibleGroups.length;
+    const key = JSON.stringify(visibleGroups);
+    if (key === lastSignature) return;
+    lastSignature = key;
+    if (typeof overlays?.setOverlayEntries === 'function') {
+      overlays.setOverlayEntries(
+        SOURCE,
+        visibleGroups
+          .filter((g) => g.ids.length === 1 && cells.get(g.ids[0])?.record)
+          .map((g) => {
+            const entity = dataSource.entities.getById(g.ids[0]);
+            return {
+              ...createInfrastructureOverlayEntry({
+                id: entity.id,
+                source: SOURCE,
+                position: Cesium.Cartesian3.fromDegrees(...g.center),
+                title: entity.name,
+                details: ['USGS'], // i18n-ignore: agency acronym
+                accent: '#56b4e9',
+                priority: 1,
+              }),
+              interactive: true,
+              accessibilityLabel: entity.name,
+              activate: () => onSelectRecord(entity),
+            };
+          }),
+        { cohortLimit: 24, collisionCapacity: 24, moving: false },
+      );
+      overlays.setOverlaySourceVisible?.(SOURCE, true);
+    }
+  }
+  function draw(view, owned, retainDetails = false) {
+    validateCountView(view);
+    const key = JSON.stringify(view);
+    if (signature === key) return;
+    clear(true);
+    signature = key;
+    dataSource = owned;
+    if (!retainDetails) owned.entities.removeAll();
+    if (!view.cells.length && !view.detailPack?.records.length) {
+      overlays?.clearOverlaySource(SOURCE);
+      overlays?.setOverlaySourceVisible?.(SOURCE, false);
+      return;
+    }
+    const clustering = owned.clustering;
+    clustering.enabled = true;
+    clustering.minimumClusterSize = 2;
+    clustering.clusterPoints = true;
+    clustering.clusterLabels = false;
+    // Ground-clamped Cesium points are represented internally as billboards.
+    clustering.clusterBillboards = true;
+    // Cesium expands each real marker/label footprint by this CSS-pixel gap.
+    // Avoid the previous 64+ px minimum that swallowed well-separated sites.
+    const canvas = viewer.scene.canvas ?? {};
+    const area = (canvas.clientWidth || 1600) * (canvas.clientHeight || 900);
+    const density =
+      (view.cells.length + (view.detailPack?.records.length ?? 0)) / area;
+    // Aggregate groups can grow beyond their input symbols. Reserve at least
+    // one maximum output radius plus a 10px gap, while exact dots keep their
+    // finer native spacing. This changes grouping, never represented totals.
+    clustering.pixelRange = view.cells.length
+      ? Math.max(32, Math.min(44, Math.round(1000 * Math.sqrt(density))))
+      : Math.max(4, Math.min(8, Math.round(200 * Math.sqrt(density))));
+    for (const record of view.detailPack?.records ?? []) {
+      const id = `us-groundwater:${record.id}`;
+      if (!owned.entities.getById(id)) continue;
+      cells.set(id, {
+        count: 1,
+        record: true,
+        center: [record.longitude, record.latitude],
+        bounds: [
+          record.longitude,
+          record.latitude,
+          record.longitude,
+          record.latitude,
+        ],
+      });
+      inputCount++;
+    }
+    for (const cell of view.cells) {
+      const center = cell.center ?? [
+        (cell.bounds[0] + cell.bounds[2]) / 2,
+        (cell.bounds[1] + cell.bounds[3]) / 2,
+      ];
+      const id = 'well-cell:' + cell.bounds.join(':');
+      cells.set(id, cell);
+      inputCount += cell.count;
+      owned.entities.add({
+        id,
+        name: t('{count} recorded USGS locations. Zoom to group.', {
+          count: cell.count.toLocaleString(),
+        }),
+        position: Cesium.Cartesian3.fromDegrees(...center),
+        billboard: {
+          image: countMarkerImage(cell.count),
+          width: circleDiameter(cell.count),
+          height: circleDiameter(cell.count),
+          disableDepthTestDistance: Infinity,
+        },
+      });
+    }
+    removeCluster = clustering.clusterEvent.addEventListener(
+      (members, cluster) => {
+        const group = aggregateMembers(members, cells);
+        cluster.point.id = members;
+        cluster.label.id = members;
+        cluster.billboard.id = members;
+        cluster.billboard.show = true;
+        cluster.billboard.image = countMarkerImage(group.count);
+        cluster.billboard.width = cluster.billboard.height = circleDiameter(
+          group.count,
+        );
+        cluster.billboard.disableDepthTestDistance = Infinity;
+        cluster.point.show = false;
+        // Cesium creates a default cluster label; keep it hidden. The single
+        // billboard already carries the count, so no label text/style is needed.
+        cluster.label.show = false;
+        cluster.point.disableDepthTestDistance = Infinity;
+        cluster.point.color = Cesium.Color.fromCssColorString('#2287b8');
+        cluster.point.pixelSize = circleDiameter(group.count);
+        cluster.point.outlineColor = Cesium.Color.BLACK;
+        cluster.point.outlineWidth = 2;
+        dirty = true;
+      },
+    );
+    dirty = true;
+    removeFrame = viewer.scene.postRender?.addEventListener(() => {
+      try {
+        publish();
+      } catch (failure) {
+        dirty = false;
+        onError(failure);
+      }
+    });
+    removeChanged = viewer.camera.changed?.addEventListener(() => {
+      dirty = true;
+    });
+    removeEnd = viewer.camera.moveEnd?.addEventListener(() => {
+      dirty = true;
+    });
+    viewer.scene.requestRender?.();
+  }
+  return {
+    draw,
+    clear,
+    zoom,
+    describeDetails: () => {},
+    getStats: () => ({
+      groups: screenGroups,
+      aggregateInputs: cells.size,
+      recordCount: inputCount,
+    }),
+  };
+}
