+++ b/src/layers/usGroundwater/source.js
@@ -0,0 +1,49 @@
+import { readResponseJsonCapped } from '../../sources/httpBody.js';
+import { validateWellPack, WELL_LIMITS } from './pack.js';
+
+/** Load one caller-owned same-origin snapshot. No USGS calls, keys or polling. */
+export function createWellPackSource({
+  url,
+  fetchImpl = globalThis.fetch,
+  timeoutMs = 10000,
+  validatePack = validateWellPack,
+} = {}) {
+  if (
+    typeof url !== 'string' ||
+    !url.startsWith('/') ||
+    url.startsWith('//') ||
+    url.includes('\\') ||
+    /[\u0000-\u001f\u007f]/.test(url)
+  )
+    throw new TypeError('Well pack requires a same-origin absolute path');
+  // Resolve against the page origin, not document.baseURI. Fetching the admitted
+  // absolute URL also prevents a cross-origin <base> from changing the target.
+  const base = new URL(globalThis.location?.origin ?? 'https://gev.invalid');
+  const target = new URL(url, base);
+  if (
+    !['http:', 'https:'].includes(base.protocol) ||
+    target.origin !== base.origin
+  )
+    throw new TypeError('Well pack requires a same-origin absolute path');
+  return {
+    async getSnapshot({ signal } = {}) {
+      const deadline = AbortSignal.timeout(timeoutMs);
+      const combined = signal ? AbortSignal.any([signal, deadline]) : deadline;
+      combined.throwIfAborted();
+      const response = await fetchImpl(target.href, {
+        signal: combined,
+        credentials: 'omit',
+        redirect: 'error',
+      });
+      if (!response.ok)
+        throw new Error(`Well pack unavailable (HTTP ${response.status})`);
+      const pack = await readResponseJsonCapped(
+        response,
+        WELL_LIMITS.bytes,
+        combined,
+      );
+      combined.throwIfAborted();
+      return validatePack(pack);
+    },
+  };
+}
diff --git a/src/layers/usGroundwater/spatialSource.js b/src/layers/usGroundwater/spatialSource.js
new file mode 100644
--- /dev/null
+++ b/src/layers/usGroundwater/spatialSource.js
@@ -0,0 +1,338 @@
+import { readResponseBytesCapped } from '../../sources/httpBody.js';
+import { validateWellPack, WELL_LIMITS } from './pack.js';
+import { refineCountView } from './mixedDetail.js';
+import { readTiles } from './tileReads.js';
+import { createPartitionedCountLoader } from './partitionedCounts.js';
+import {
+  intersects,
+  validateCountGrids,
+  countView,
+  validateCountView,
+} from './countGrids.js';
+/** One replaceable local index; bounded records and bytes per viewport; complete count grids otherwise. */
+export function createSpatialWellSource({
+  fetchImpl = globalThis.fetch,
+  base = '/well-index-v1/',
+} = {}) {
+  if (!/^\/[\w-]+\/$/.test(base))
+    throw new TypeError('Local index path required');
+  const origin = new URL(globalThis.location?.origin ?? 'https://gev.invalid');
+  if (!['http:', 'https:'].includes(origin.protocol))
+    throw new TypeError('HTTP origin required');
+  let generation = 0;
+  let active;
+  let cachedCounts;
+  const partitionedLoader = createPartitionedCountLoader();
+  // Immutable, hash-verified bytes only. Keep the mutable index revalidated.
+  const tileCache = new Map();
+  let cacheBytes = 0;
+  const cacheLimit = 16 * 1024 * 1024;
+  return {
+    label: 'USGS', // i18n-ignore: agency acronym
+    viewport: true,
+    async getSnapshot({
+      signal,
+      bounds = [-180, -90, 180, 90],
+      countBudget = 4096,
+      detailPriority,
+    } = {}) {
+      const current = ++generation;
+      active?.abort();
+      active = new AbortController();
+      const combined = AbortSignal.any([
+        active.signal,
+        AbortSignal.timeout(15000),
+        ...(signal ? [signal] : []),
+      ]);
+      let totalBytes = 0;
+      const read = async (
+        path,
+        hash,
+        cap = WELL_LIMITS.bytes,
+        expectedBytes,
+      ) => {
+        combined.throwIfAborted();
+        const cached = tileCache.get(hash);
+        if (cached) {
+          tileCache.delete(hash);
+          tileCache.set(hash, cached);
+          totalBytes += cached.length;
+          if (totalBytes > 56 * 1024 * 1024)
+            throw new TypeError('Viewport byte budget');
+          return JSON.parse(new TextDecoder().decode(cached));
+        }
+        const response = await fetchImpl(new URL(path, origin).href, {
+          signal: combined,
+          credentials: 'omit',
+          redirect: 'error',
+          cache: 'no-cache',
+        });
+        if (!response.ok)
+          throw new Error(`Well index unavailable (HTTP ${response.status})`);
+        const bytes = await readResponseBytesCapped(response, cap, combined);
+        if (expectedBytes !== undefined && bytes.length !== expectedBytes)
+          throw new TypeError('Count reference byte mismatch');
+        totalBytes += bytes.length;
+        if (totalBytes > 56 * 1024 * 1024)
+          throw new TypeError('Viewport byte budget');
+        if (hash) {
+          const digest = [
+            ...new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)),
+          ]
+            .map((x) => x.toString(16).padStart(2, '0'))
+            .join('');
+          if (digest !== hash) throw new Error('Well tile hash mismatch');
+        }
+        combined.throwIfAborted();
+        if (current !== generation)
+          throw new DOMException('Stale viewport', 'AbortError');
+        if (
+          hash &&
+          !path.endsWith('.counts.json') &&
+          bytes.length <= cacheLimit
+        ) {
+          if (tileCache.has(hash)) {
+            cacheBytes -= tileCache.get(hash).length;
+            tileCache.delete(hash);
+          }
+          while (cacheBytes + bytes.length > cacheLimit) {
+            const oldest = tileCache.keys().next().value;
+            cacheBytes -= tileCache.get(oldest).length;
+            tileCache.delete(oldest);
+          }
+          tileCache.set(hash, bytes);
+          cacheBytes += bytes.length;
+        }
+        return JSON.parse(new TextDecoder().decode(bytes));
+      };
+      if (
+        bounds !== null &&
+        (!Array.isArray(bounds) ||
+          bounds.length !== 4 ||
+          !bounds.every(Number.isFinite) ||
+          bounds[0] < -180 ||
+          bounds[0] > 180 ||
+          bounds[2] < -180 ||
+          bounds[2] > 180 ||
+          bounds[1] < -90 ||
+          bounds[3] > 90 ||
+          bounds[1] >= bounds[3])
+      )
+        throw new TypeError('Invalid viewport');
+      const index = await read(`${base}index.json`);
+      if (
+        index.schemaVersion !== 1 ||
+        index.kind !== 'gev-well-spatial-index' ||
+        !Array.isArray(index.regions) ||
+        index.regions.length > 40000
+      )
+        throw new TypeError('Invalid spatial index');
+      for (const tile of index.regions) {
+        if (
+          !/^[a-f0-9]{64}\.json$/.test(tile.url) ||
+          tile.url !== `${tile.sha256}.json` ||
+          !Array.isArray(tile.bounds) ||
+          tile.bounds.length !== 4 ||
+          !tile.bounds.every(Number.isFinite) ||
+          tile.bounds[0] < -180 ||
+          tile.bounds[2] > 180 ||
+          tile.bounds[1] < -90 ||
+          tile.bounds[3] > 90 ||
+          tile.bounds[0] >= tile.bounds[2] ||
+          tile.bounds[1] >= tile.bounds[3] ||
+          !Number.isInteger(tile.count) ||
+          tile.count < 0 ||
+          tile.count > 500
+        )
+          throw new TypeError('Invalid spatial tile');
+      }
+      const matching = index.regions.filter(
+        (tile) => bounds && intersects(tile.bounds, bounds),
+      );
+      let grids;
+      let partitioned = false,
+        countCapped = false;
+      if (index.aggregates) {
+        if (
+          new Set(index.regions.map((t) => t.url)).size !==
+            index.regions.length ||
+          index.regions.reduce((n, t) => n + t.count, 0) !==
+            index.indexedRecords
+        )
+          throw new TypeError('Index accounting mismatch');
+        const ref = index.aggregates;
+        if (ref.schemaVersion === 2) {
+          partitioned = true;
+          cachedCounts = undefined;
+          if (!bounds)
+            return validateCountView({
+              schemaVersion: 1,
+              kind: 'gev-well-count-view',
+              cells: [],
+              degrees: 32,
+              total: index.indexedRecords,
+              reason: 'No visible ellipsoid',
+              coverageComplete: false,
+            });
+          const loaded = await partitionedLoader.load(
+            ref,
+            index.indexedRecords,
+            bounds,
+            countBudget,
+            (part) =>
+              read(base + part.url, part.sha256, part.bytes, part.bytes),
+          );
+          grids = loaded.grids;
+          countCapped = loaded.capped;
+        } else {
+          if (
+            !/^[a-f0-9]{64}\.counts\.json$/.test(ref.url) ||
+            ref.url !== `${ref.sha256}.counts.json`
+          )
+            throw new TypeError('Invalid count reference');
+          if (!bounds)
+            return validateCountView({
+              schemaVersion: 1,
+              kind: 'gev-well-count-view',
+              cells: [],
+              degrees: 32,
+              total: index.indexedRecords,
+              reason: 'No visible ellipsoid',
+              coverageComplete: false,
+            });
+          if (
+            cachedCounts?.sha === ref.sha256 &&
+            cachedCounts.total === index.indexedRecords
+          )
+            grids = cachedCounts.grids;
+          else {
+            grids = validateCountGrids(
+              await read(base + ref.url, ref.sha256, 32 * 1024 * 1024),
+              index.indexedRecords,
+            );
+            cachedCounts = {
+              sha: ref.sha256,
+              total: index.indexedRecords,
+              grids,
+            };
+          }
+        }
+      }
+      const rows = matching.reduce((n, t) => n + t.count, 0);
+      const bytes = matching.reduce(
+        (n, t) => n + (Number.isSafeInteger(t.bytes) ? t.bytes : 0),
+        0,
+      );
+      const over =
+        rows > 2000 || bytes > 16 * 1024 * 1024 || matching.length > 256;
+      if (grids && (!bounds || over)) {
+        const view = {
+          ...countView(
+            grids,
+            bounds,
+            !bounds
+              ? 'No visible ellipsoid'
+              : over
+                ? 'Detail record/byte budget; showing complete counts'
+                : 'Overview',
+            countBudget,
+          ),
+          referenceRetrievedAt: index.fallbackAcquisition?.retrievedAt,
+        };
+        if (countCapped)
+          view.reason +=
+            '; fine summary budget reached, complete coarser counts retained';
+        // A source-only caller has no screen resolution evidence. Do not eagerly
+        // hydrate arbitrary detail islands at national zoom. The app supplies its
+        // existing screen-aware eligibility callback for mixed views.
+        if (partitioned && !detailPriority) return view;
+        const startBytes = totalBytes;
+        const mixed = await refineCountView(
+          view,
+          index,
+          async (tile) => {
+            const pack = await read(base + tile.url, tile.sha256);
+            if (totalBytes - startBytes > 16 * 1024 * 1024)
+              throw new TypeError('Detail byte budget');
+            return pack;
+          },
+          detailPriority,
+        );
+        combined.throwIfAborted();
+        return mixed;
+      }
+      if (over)
+        throw new TypeError('Detail budget exceeded; count index required');
+      // Every intersecting pack is admitted when within the record/byte budget.
+      const selected = matching;
+      const records = new Map();
+      const acquisitions = new Map();
+      const detailStartBytes = totalBytes;
+      const packs = await readTiles(selected, (tile) =>
+        read(base + tile.url, tile.sha256),
+      );
+      for (const [i, tile] of selected.entries()) {
+        const pack = validateWellPack(packs[i]);
+        if (totalBytes - detailStartBytes > 16 * 1024 * 1024)
+          throw new TypeError('Detail byte budget');
+        if (pack.records.length !== tile.count)
+          throw new TypeError('Tile accounting mismatch');
+        for (const r of pack.records) {
+          if (
+            r.longitude < tile.bounds[0] ||
+            r.longitude > tile.bounds[2] ||
+            r.latitude < tile.bounds[1] ||
+            r.latitude > tile.bounds[3]
+          )
+            throw new TypeError('Tile spatial accounting mismatch');
+          if (records.has(r.id)) {
+            if (JSON.stringify(records.get(r.id)) !== JSON.stringify(r))
+              throw new TypeError('Conflicting source ID');
+          } else records.set(r.id, r);
+        }
+        for (const a of pack.acquisitions)
+          acquisitions.set(JSON.stringify(a), a);
+        if (acquisitions.size > 256) {
+          if (grids)
+            return countView(
+              grids,
+              bounds,
+              'Provenance budget; showing complete counts',
+              countBudget,
+            );
+          throw new TypeError('Detail provenance budget');
+        }
+      }
+      if (!acquisitions.size)
+        acquisitions.set('fallback', index.fallbackAcquisition);
+      const inBounds = (r) =>
+        bounds &&
+        r.latitude >= bounds[1] &&
+        r.latitude <= bounds[3] &&
+        (bounds[0] <= bounds[2]
+          ? r.longitude >= bounds[0] && r.longitude <= bounds[2]
+          : r.longitude >= bounds[0] || r.longitude <= bounds[2]);
+      const pack = {
+        schemaVersion: 1,
+        kind: 'gev-us-groundwater-wells',
+        mode: 'snapshot',
+        // A catalog count requires complete index accounting, not tile counts.
+        ...(grids ? { catalogTotal: index.indexedRecords } : {}),
+        coverage: {
+          country: 'US',
+          complete: false,
+          indexed: true,
+          description: `Partial USGS source records; ${records.size} admitted sites across all ${matching.length} intersecting packs. Detail budget: 2,000 records / 16 MiB. All in-view admitted records are eligible; absent dots do not mean absent wells. Consult source acquisition and measurement dates.`,
+        },
+        acquisitions: [...acquisitions.values()],
+        records: [...records.values()].filter(inBounds),
+      };
+      combined.throwIfAborted();
+      return validateWellPack(pack);
+    },
+    cancel() {
+      generation++;
+      active?.abort();
+    },
+  };
+}
diff --git a/src/layers/usGroundwater/spatialSource.test.mjs b/src/layers/usGroundwater/spatialSource.test.mjs
new file mode 100644
--- /dev/null
+++ b/src/layers/usGroundwater/spatialSource.test.mjs
@@ -0,0 +1,423 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import sample from '../../../fixtures/us-groundwater/v1/expected-pack.json' with { type: 'json' };
+import { createSpatialWellSource } from './spatialSource.js';
+function harness(duplicate = false) {
+  let index = {
+    schemaVersion: 1,
+    kind: 'gev-well-spatial-index',
+    fallbackAcquisition: sample.acquisitions[0],
+    regions: [],
+  };
+  const bodies = new Map();
+  const calls = [];
+  for (let i = 0; i < 6; i++) {
+    const pack = structuredClone(sample);
+    pack.records = [structuredClone(sample.records[duplicate ? 0 : i])];
+    pack.records[0].longitude = duplicate ? 1 : i * 10 + 1;
+    pack.records[0].latitude = 1;
+    const body = JSON.stringify(pack);
+    const hash = createHash('sha256').update(body).digest('hex');
+    index.regions.push({
+      url: `${hash}.json`,
+      sha256: hash,
+      count: 1,
+      bounds: duplicate ? [0, 0, 5, 5] : [i * 10, 0, i * 10 + 5, 5],
+    });
+    bodies.set(`/well-index-v1/${hash}.json`, body);
+  }
+  const fetchImpl = async (path, opts) => {
+    path = new URL(path).pathname;
+    calls.push(path);
+    opts.signal.throwIfAborted();
+    return new Response(
+      path.endsWith('index.json') ? JSON.stringify(index) : bodies.get(path),
+    );
+  };
+  return {
+    source: createSpatialWellSource({ fetchImpl }),
+    calls,
+    index,
+    bodies,
+  };
+}
+test('viewport switches spatial packs; broad view stays bounded and deduplicates IDs', async () => {
+  const h = harness();
+  const a = await h.source.getSnapshot({ bounds: [0, 0, 5, 5] });
+  const b = await h.source.getSnapshot({ bounds: [20, 0, 25, 5] });
+  assert.notEqual(a.records[0].id, b.records[0].id);
+  h.calls.length = 0;
+  const wide = await h.source.getSnapshot();
+  assert.equal(wide.records.length, 6);
+  assert.equal(h.calls.length, 5, 'index plus four uncached immutable packs');
+  assert.match(wide.coverage.description, /all 6/);
+  const d = harness(true);
+  assert.equal((await d.source.getSnapshot()).records.length, 1);
+});
+test('empty partial coverage is valid, and a new valid index batch becomes visible', async () => {
+  const h = harness();
+  const removed = h.index.regions.splice(0);
+  assert.equal((await h.source.getSnapshot()).records.length, 0);
+  h.index.regions.push(removed[0]);
+  assert.equal((await h.source.getSnapshot()).records.length, 1);
+});
+
+test('conflicting records sharing a source ID are refused rather than overwritten', async () => {
+  const h = harness(true);
+  const tile = h.index.regions[1];
+  const pack = JSON.parse(h.bodies.get('/well-index-v1/' + tile.url));
+  pack.records[0].name = 'Different reported metadata';
+  const body = JSON.stringify(pack);
+  tile.sha256 = createHash('sha256').update(body).digest('hex');
+  tile.url = `${tile.sha256}.json`;
+  h.bodies.set('/well-index-v1/' + tile.url, body);
+  await assert.rejects(h.source.getSnapshot(), /Conflicting source ID/);
+});
+test('hash tampering and malformed index fail closed; cancellation rejects', async () => {
+  const h = harness();
+  h.bodies.set('/well-index-v1/' + h.index.regions[0].url, '{}');
+  await assert.rejects(h.source.getSnapshot({ bounds: [0, 0, 5, 5] }), /hash/);
+  h.index.regions[0].url = '../outside';
+  await assert.rejects(h.source.getSnapshot(), /tile/);
+  const controller = new AbortController();
+  controller.abort();
+  await assert.rejects(h.source.getSnapshot({ signal: controller.signal }));
+});
+test('newer viewport aborts old fetch and stale completion never returns a pack', async () => {
+  let resolve;
+  let oldSignal;
+  let count = 0;
+  const h = harness();
+  const source = createSpatialWellSource({
+    fetchImpl: async (path, options) => {
+      if (++count === 1) {
+        oldSignal = options.signal;
+        return new Promise((r) => {
+          resolve = r;
+        });
+      }
+      return new Response(JSON.stringify({ ...h.index, regions: [] }));
+    },
+  });
+  const old = source.getSnapshot();
+  const rejection = assert.rejects(old);
+  await source.getSnapshot();
+  assert.equal(oldSignal.aborted, true);
+  resolve(new Response(JSON.stringify(h.index)));
+  await rejection;
+  source.cancel();
+});
+import { GRID_SIZES, validateCountGrids, countView } from './countGrids.js';
+function grids(points) {
+  return {
+    schemaVersion: 1,
+    kind: 'gev-well-count-grids',
+    centerMethod: 'record-mean',
+    total: points.length,
+    levels: GRID_SIZES.map((size) => {
+      const cells = new Map();
+      for (const [lon, lat] of points) {
+        const x = Math.floor((lon + 180) / size),
+          y = Math.floor((lat + 90) / size),
+          key = `${x}:${y}`;
+        if (!cells.has(key))
+          cells.set(key, {
+            bounds: [
+              x * size - 180,
+              y * size - 90,
+              Math.min(180, (x + 1) * size - 180),
+              Math.min(90, (y + 1) * size - 90),
+            ],
+            count: 0,
+            center: [0, 0],
+          });
+        cells.get(key).count++;
+        cells.get(key).center[0] += lon;
+        cells.get(key).center[1] += lat;
+      }
+      return {
+        degrees: size,
+        total: points.length,
+        cells: [...cells.values()].map((c) => ({
+          ...c,
+          center: c.center.map((x) => x / c.count),
+        })),
+      };
+    }),
+  };
+}
+function addCounts(h, points) {
+  const value = grids(points),
+    body = JSON.stringify(value),
+    sha = createHash('sha256').update(body).digest('hex');
+  h.index.indexedRecords = points.length;
+  h.index.aggregates = { url: `${sha}.counts.json`, sha256: sha };
+  h.bodies.set(`/well-index-v1/${sha}.counts.json`, body);
+  return value;
+}
+
+test('revisited tiles reuse verified bytes without sharing mutable records or concealing changed index hashes', async () => {
+  const h = harness();
+  const bounds = [0, 0, 5, 5];
+  const first = await h.source.getSnapshot({ bounds });
+  const name = first.records[0].name;
+  first.records[0].name = 'caller mutation';
+  h.calls.length = 0;
+  const next = await h.source.getSnapshot({ bounds });
+  assert.equal(next.records[0].name, name);
+  assert.deepEqual(h.calls, ['/well-index-v1/index.json']);
+  const tile = h.index.regions[0];
+  const changed = JSON.parse(h.bodies.get('/well-index-v1/' + tile.url));
+  changed.records[0].name = 'New source metadata';
+  const body = JSON.stringify(changed);
+  tile.sha256 = createHash('sha256').update(body).digest('hex');
+  tile.url = tile.sha256 + '.json';
+  h.bodies.set('/well-index-v1/' + tile.url, body);
+  assert.equal(
+    (await h.source.getSnapshot({ bounds })).records[0].name,
+    'New source metadata',
+  );
+});
+
+test('hierarchical twelve separates into two sixes without inventing coincident locations', () => {
+  const points = [
+    ...Array(6).fill([1.001, 1.001]),
+    ...Array(6).fill([1.1, 1.1]),
+  ];
+  const value = validateCountGrids(grids(points), 12);
+  const wide = countView(value, [0, 0, 2, 2], 'test', 1);
+  assert.deepEqual(
+    wide.cells.map((c) => c.count),
+    [12],
+  );
+  const fine = countView(value, [0, 0, 2, 2], 'test', 4096);
+  assert.deepEqual(
+    fine.cells.map((c) => c.count),
+    [6, 6],
+  );
+  fine.cells.forEach((c, i) =>
+    c.center.forEach((v) => assert.ok(Math.abs(v - [1.001, 1.1][i]) < 1e-12)),
+  );
+  assert.equal(
+    fine.cells.reduce((n, c) => n + c.count, 0),
+    12,
+  );
+});
+
+test('reconciled manifest total accompanies narrow detail and complete count views', async () => {
+  const h = harness();
+  addCounts(
+    h,
