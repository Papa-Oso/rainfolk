+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as Cesium from 'cesium';
+import sample from '../../../fixtures/us-groundwater/v1/expected-pack.json' with { type: 'json' };
+import {
+  createCountRenderer,
+  circleDiameter,
+  aggregateMembers,
+  countMarkerImage,
+} from './countRenderer.js';
+test('count circles and numeric labels remain bounded, survive repeat draw and dispose', () => {
+  const grounds = new Cesium.PrimitiveCollection();
+  let destination;
+  const viewer = {
+    scene: { groundPrimitives: grounds },
+    camera: {
+      flyTo: (options) => {
+        destination = options.destination;
+      },
+    },
+  };
+  const data = new Cesium.CustomDataSource('test'),
+    renderer = createCountRenderer(viewer);
+  const view = {
+    schemaVersion: 1,
+    kind: 'gev-well-count-view',
+    total: 10,
+    degrees: 2,
+    coverageComplete: false,
+    reason: 'test',
+    centerMethod: 'record-mean',
+    cells: [{ bounds: [0, 0, 2, 2], count: 10, center: [0.2, 0.3] }],
+  };
+  renderer.draw(view, data);
+  assert.equal(grounds.length, 0);
+  assert.equal(data.entities.values.length, 1);
+  renderer.draw(view, data);
+  assert.equal(grounds.length, 0);
+  assert.equal(data.entities.values.length, 1);
+  const entity = data.entities.values[0];
+  const point = Cesium.Cartographic.fromCartesian(
+    entity.position.getValue(Cesium.JulianDate.now()),
+  );
+  assert.ok(Math.abs(Cesium.Math.toDegrees(point.longitude) - 0.2) < 1e-8);
+  assert.equal(renderer.zoom(entity), true);
+  assert.deepEqual(destination, Cesium.Rectangle.fromDegrees(0, 0, 2, 2));
+  assert.equal(renderer.zoom({ id: 'unowned' }), false);
+  assert.ok(circleDiameter(1000000) <= 56);
+  assert.ok(circleDiameter(1) < circleDiameter(1000));
+  renderer.draw({ ...view, cells: [] }, data);
+  assert.equal(grounds.length, 0);
+  assert.equal(data.entities.values.length, 0);
+  assert.throws(() =>
+    renderer.draw({ ...view, cells: Array(4097).fill(view.cells[0]) }, data),
+  );
+  renderer.clear();
+  renderer.clear();
+  assert.equal(grounds.length, 0);
+});
+
+test('native screen grouping sums record weights, handles dateline bounds and preserves split totals', () => {
+  const cells = new Map([
+    ['a', { count: 10, center: [179, 5], bounds: [178, 4, 180, 6] }],
+    ['b', { count: 90, center: [-179, 5], bounds: [-180, 4, -178, 6] }],
+    ['c', { count: 2, center: [-170, 5], bounds: [-172, 4, -168, 6] }],
+  ]);
+  const group = aggregateMembers(
+    [{ id: 'a' }, { id: 'b' }, { id: 'a' }],
+    cells,
+  );
+  assert.equal(group.count, 100);
+  assert.ok(Math.abs(group.center[0] + 179.2) < 1e-9);
+  assert.ok(group.bounds[0] > group.bounds[2]);
+  const split = ['a', 'b', 'c'].map((id) => aggregateMembers([{ id }], cells));
+  assert.equal(
+    split.reduce((n, g) => n + g.count, 0),
+    102,
+  );
+  assert.equal(group.count + split[2].count, 102);
+  assert.throws(() => aggregateMembers([{ id: 'missing' }], cells));
+});
+
+test('loaded singletons stay plain dots with native actionable flags; crowded records drill down', () => {
+  const frame = new Cesium.Event(),
+    changed = new Cesium.Event(),
+    end = new Cesium.Event();
+  let flags = [],
+    selected,
+    destination;
+  const viewer = {
+    scene: {
+      canvas: { clientWidth: 1600, clientHeight: 900 },
+      postRender: frame,
+      requestRender() {},
+    },
+    camera: {
+      changed,
+      moveEnd: end,
+      flyTo: (o) => {
+        destination = o.destination;
+      },
+    },
+  };
+  const data = new Cesium.CustomDataSource('exact');
+  const entities = sample.records.map((r) =>
+    data.entities.add({
+      id: 'us-groundwater:' + r.id,
+      name: r.name,
+      position: Cesium.Cartesian3.fromDegrees(r.longitude, r.latitude),
+      point: { pixelSize: 10 },
+    }),
+  );
+  const renderer = createCountRenderer(viewer, {
+    overlays: {
+      setOverlayEntries: (_s, e) => {
+        flags = e;
+      },
+      clearOverlaySource() {},
+    },
+    onSelectRecord: (entity) => {
+      selected = entity;
+      return true;
+    },
+  });
+  renderer.draw(
+    {
+      schemaVersion: 1,
+      kind: 'gev-well-count-view',
+      cells: [],
+      degrees: 0.03125,
+      total: 6,
+      coverageComplete: false,
+      detailPack: sample,
+    },
+    data,
+    true,
+  );
+  assert.ok(
+    entities.every((e) => !e.label),
+    'actual wells never have a numeric 1 label',
+  );
+  assert.ok(
+    data.clustering.pixelRange <= 8,
+    'exact views split resolvable neighbors automatically rather than retaining overview padding',
+  );
+  assert.equal(
+    circleDiameter(2),
+    22,
+    'genuinely overlapping small groups stay subordinate to overview clusters',
+  );
+  const cluster = { point: {}, label: {}, billboard: {} };
+  data.clustering.clusterEvent.raiseEvent(entities.slice(0, 2), cluster);
+  data.clustering._clusterBillboardCollection = {
+    length: 1,
+    get: () => cluster.billboard,
+  };
+  frame.raiseEvent();
+  assert.equal(cluster.label.show, false);
+  assert.equal(
+    cluster.label.text,
+    undefined,
+    'count text lives only in the billboard',
+  );
+  assert.equal(cluster.billboard.image, countMarkerImage(2));
+  assert.equal(cluster.point.show, false);
+  assert.equal(renderer.getStats().recordCount, 6);
+  assert.equal(flags.length, 4, 'only unclustered exact records receive flags');
+  assert.ok(
+    flags.every(
+      (e) =>
+        e.variant === 'card' &&
+        e.edgeFade === 'keyhole' &&
+        e.interactive &&
+        e.accessibilityLabel,
+    ),
+  );
+  assert.equal(flags[0].activate(), true);
+  assert.equal(selected.id, flags[0].id);
+  assert.equal(
+    renderer.zoom(selected),
+    false,
+    'a loaded well is selected, not treated as a group',
+  );
+  assert.equal(renderer.zoom(cluster.billboard.id), true);
+  assert.ok(destination);
+  assert.equal(renderer.zoom([{ id: 'foreign-layer' }]), false);
+  renderer.clear();
+  assert.equal(frame.numberOfListeners, 0);
+});
+test('native scene owns count markers below the scope; weighted drilldown and cleanup conserve records', () => {
+  const frame = new Cesium.Event(),
+    changed = new Cesium.Event(),
+    moveEnd = new Cesium.Event();
+  let entries = [],
+    clears = 0,
+    destination,
+    selected;
+  const overlays = {
+    setOverlayEntries: (_id, value) => {
+      entries = value;
+    },
+    setOverlaySourceVisible() {},
+    clearOverlaySource() {
+      clears++;
+    },
+  };
+  const viewer = {
+    scene: {
+      canvas: { clientWidth: 2560, clientHeight: 1276 },
+      postRender: frame,
+      requestRender() {},
+    },
+    camera: { changed, moveEnd, flyTo: (o) => (destination = o.destination) },
+  };
+  const data = new Cesium.CustomDataSource('screen-test');
+  const renderer = createCountRenderer(viewer, {
+    overlays,
+    onSelectGroup: (n) => (selected = n),
+  });
+  const view = {
+    schemaVersion: 1,
+    kind: 'gev-well-count-view',
+    total: 100,
+    degrees: 2,
+    coverageComplete: false,
+    centerMethod: 'record-mean',
+    cells: [
+      { bounds: [0, 0, 2, 2], count: 10, center: [1, 1] },
+      { bounds: [2, 0, 4, 2], count: 90, center: [3, 1] },
+    ],
+  };
+  renderer.draw(view, data);
+  assert.equal(data.clustering.enabled, true);
+  assert.ok(
+    data.clustering.pixelRange >= circleDiameter(1000000) / 2 + 10 &&
+      data.clustering.pixelRange <= 44,
+  );
+  const members = data.entities.values;
+  const point = {};
+  const billboard = {};
+  data.clustering.clusterEvent.raiseEvent(members, {
+    point,
+    label: {},
+    billboard,
+  });
+  data.clustering._clusterBillboardCollection = {
+    length: 1,
+    get: () => billboard,
+  };
+  frame.raiseEvent();
+  assert.equal(entries.length, 0, 'no count bubbles in above-mask DOM overlay');
+  assert.equal(
+    billboard.image,
+    countMarkerImage(100),
+    'native scene renders circle and count in one image',
+  );
+  assert.equal(renderer.getStats().recordCount, 100);
+  assert.equal(renderer.zoom(members), true);
+  assert.equal(selected, 100);
+  assert.deepEqual(destination, Cesium.Rectangle.fromDegrees(0, 0, 4, 2));
+  data.clustering._clusterBillboardCollection = { length: 0, get() {} };
+  changed.raiseEvent();
+  frame.raiseEvent();
+  assert.equal(entries.length, 0);
+  assert.equal(renderer.getStats().groups, 2);
+  assert.equal(renderer.getStats().recordCount, 100);
+  const previous = entries;
+  renderer.draw(
+    {
+      ...view,
+      total: 101,
+      cells: [{ ...view.cells[0], count: 11 }, view.cells[1]],
