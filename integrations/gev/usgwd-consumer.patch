+
+test('catalog publication waits for admitted snapshot and failed refresh keeps last-good summary', async () => {
+  const h=harness();let index={...h.index,indexedRecords:6,catalogRecords:6,unmappedRecords:0};const published=[];
+  const source=createSpatialWellSource({onCatalog:s=>published.push(s),fetchImpl:async url=>{
+    const p=new URL(url).pathname;
+    return new Response(p.endsWith('index.json')?JSON.stringify(index):h.bodies.get(p));
+  }});
+  await source.getSnapshot();assert.equal(published.length,1);
+  assert.deepEqual(published[0],{catalogRecords:6,mappedRecords:6,unmappedRecords:0,distinctPhysicalWells:null});
+  index={schemaVersion:999,kind:'invalid',sourceKind:'USGWD',children:[],regions:[],indexedRecords:123,catalogRecords:987,unmappedRecords:864};
+  await assert.rejects(source.getSnapshot());assert.equal(published.length,1);
+  assert.equal(published[0].catalogRecords,6);
+});
+
+
+test('allowlisted HTTPS data origin loads root and hashed detail inside version directory', async () => {
+  const h = harness(), calls = [];
+  const base = 'https://data.example.test/wells/releases/synthetic-001/';
+  const source = createSpatialWellSource({base, allowedDataOrigins:['https://data.example.test'], fetchImpl:async (url, options) => {
+    assert.ok(url.startsWith(base));
+    assert.equal(options.credentials,'omit'); assert.equal(options.redirect,'error');
+    assert.equal(options.cache,'no-cache');
+    calls.push(url);
+    const relative = url.slice(base.length);
+    return new Response(relative === 'index.json' ? JSON.stringify(h.index) : h.bodies.get('/well-index-v1/'+relative));
+  }});
+  const pack = await source.getSnapshot({bounds:[0,0,5,5]});
+  assert.equal(pack.records.length,1);
+  assert.deepEqual(calls,[base+'index.json',base+h.index.regions[0].url]);
+});
+
+test('remote hash tampering and manifest URL escape still fail closed', async () => {
+  const h = harness(), calls = [];
+  const base = 'https://data.example.test/wells/';
+  const source = createSpatialWellSource({base, allowedDataOrigins:['https://data.example.test'], fetchImpl:async url => {
+    assert.ok(url.startsWith(base)); calls.push(url);
+    return new Response(url === base+'index.json' ? JSON.stringify(h.index) : '{}');
+  }});
+  await assert.rejects(source.getSnapshot({bounds:[0,0,5,5]}), /hash/);
+  calls.length=0; h.index.regions[0].url='https://evil.example.test/tile.json';
+  await assert.rejects(source.getSnapshot(), /tile/);
+  assert.deepEqual(calls,[base+'index.json']);
+});
